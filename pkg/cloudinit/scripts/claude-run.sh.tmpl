#!/bin/bash
# Runs Claude Code inside the claude tmux session and records each exit on the
# data disk, so a crash-looping assistant leaves evidence that survives rebuild.
# Usage: claude-run.sh [claude args...]
#        claude-run.sh --preflight

CLAUDE="/usr/bin/claude"
LOG="/home/{{ .VMUser }}/data/claude-exit.log"
MAX_BYTES=1048576
{{ if .Telegram }}TOKEN_FILE="{{ .TokenFile }}"

# Prints the bot token from TOKEN_FILE. The file is data, never sourced: only its
# first line is read, cut at the first whitespace so a trailing newline, CR or
# stray blanks cannot end up in the value. Prints nothing if absent or empty.
read_token() {
    local tok=""
    IFS= read -r tok 2>/dev/null < "$TOKEN_FILE"
    printf '%s' "${tok%%[[:space:]]*}"
}
{{ end }}
# Appends stdin to the log. One rotated generation caps the disk a restart loop
# can consume, on every path that writes.
record() {
    if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt "$MAX_BYTES" ]; then
        mv -f "$LOG" "$LOG.1"
    fi
    cat >> "$LOG"
}

# --preflight is the unit's ExecCondition: it decides, outside tmux, whether this
# instance can start at all. The unit is Type=forking around `tmux new-session -d`,
# so systemd only sees the tmux server's status; an exit code from this script
# inside the pane is invisible to it and Restart=always would loop on a broken
# image. A failed condition makes systemd skip the start and not restart it.
# The checks live here, once, next to the launch they protect.
if [ "$1" = "--preflight" ]; then
    # Golden images built before the apt install have claude elsewhere; say so
    # instead of leaving a bare "command not found" restart loop.
    if [ ! -x "$CLAUDE" ]; then
        echo "=== $(date -Iseconds) $CLAUDE not found: this instance's golden image predates the apt-based install. Build a new golden image and rebuild (README: Updating Claude Code)." | record
        exit 1
    fi
{{ if .Telegram }}    # The Telegram plugin needs bun and the plugin seed baked into the golden image.
    # Without them claude would start and the channel would silently never come up.
    if [ ! -x "{{ .BunPath }}" ] || [ ! -d "{{ .SeedDir }}/cache" ]; then
        echo "=== $(date -Iseconds) bun or the plugin seed is missing: this instance's golden image predates zero-touch Telegram setup. Set a new golden_image.name, run motoko build, then motoko rebuild this instance (README: Updating Claude Code)." | record
        exit 1
    fi
    # The token is not in the unit environment (see the LOAD-BEARING note in
    # user-data), so without this file claude would start and the bot would
    # silently never answer.
    if [ -z "$(read_token)" ]; then
        echo "=== $(date -Iseconds) the Telegram token file $TOKEN_FILE is missing or empty. Rebuild this instance so cloud-init rewrites it (README: Updating Claude Code)." | record
        exit 1
    fi
{{ end }}    exit 0
fi

{{ if .Telegram }}# The token goes to this one claude process only (a command-prefix assignment: not
# argv, not exported into this shell). Were it in the unit environment, the tmux
# server would keep it in its global environment and hand it to every window.
TELEGRAM_BOT_TOKEN="$(read_token)" "$CLAUDE" "$@"
{{ else }}"$CLAUDE" "$@"
{{ end }}rc=$?

{
    echo "=== $(date -Iseconds) claude exited with status $rc"
    # The pane still shows claude's final output until this script ends.
    /usr/bin/tmux capture-pane -p -t claude -S -50 2>/dev/null
} | record

exit "$rc"
