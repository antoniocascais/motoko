#cloud-config
hostname: {{ .Hostname }}
locale: {{ .Locale }}
timezone: {{ .Timezone }}

users:
  - name: {{ .VMUser }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
{{ range .SSHAuthorizedKeys }}      - {{ . }}
{{ end }}
write_files:
  - path: /etc/sysctl.d/99-disable-ipv6.conf
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
  - path: /etc/apt/apt.conf.d/90proxy
    content: |
      Acquire::http::Proxy "{{ .ProxyURL }}";
      Acquire::https::Proxy "{{ .ProxyURL }}";
{{/*
  LOAD-BEARING: TELEGRAM_BOT_TOKEN goes ONLY in ~/.claude-env (0600, service
  EnvironmentFile), never in /etc/environment, managed settings, the alias or a
  state-dir dotenv file. Managed settings enable the telegram plugin for every
  claude session, so an interactive session spawns server.ts too. Without a
  token it exits at the token check, before the PID guard that SIGTERMs the
  running poller. With the token in an interactive shell it would steal the bot.
*/}}
  - path: /etc/environment
    content: |
      https_proxy={{ .ProxyURL }}
      HTTPS_PROXY={{ .ProxyURL }}
      http_proxy={{ .ProxyURL }}
      HTTP_PROXY={{ .ProxyURL }}
      no_proxy=localhost,127.0.0.1
      DISABLE_UPDATES=1
{{ if .TelegramBotToken }}      CLAUDE_CODE_PLUGIN_SEED_DIR={{ .SeedDir }}
      TELEGRAM_STATE_DIR={{ .TelegramStateDir }}
{{ end }}  - path: /etc/claude-code/managed-settings.json
    permissions: "0644"
    content: |
{{ indent 6 .ManagedSettings }}
  - path: /home/{{ .VMUser }}/.claude.json
    permissions: "0600"
    content: |
{{ indent 6 .ClaudeJSON }}
  - path: /etc/hosts
    content: |
      127.0.0.1 localhost
      127.0.1.1 {{ .Hostname }}
      {{ .BridgeIP }} proxy
  - path: /home/{{ .VMUser }}/.config/systemd/user/claude-assistant.service
    content: |
      [Unit]
      Description=Claude Code Assistant
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=forking
      WorkingDirectory=/home/{{ .VMUser }}/data
      # Type=forking around `tmux new-session -d` masks claude's exit codes (systemd
      # only sees the tmux server leave with 0), so "cannot start" guards inside the
      # pane would restart-loop under Restart=always. A failed ExecCondition skips
      # the start instead, and systemd never restarts a skipped start.
      ExecCondition=/home/{{ .VMUser }}/bin/claude-run.sh --preflight
      ExecStart=/usr/bin/tmux new-session -d -s claude '/home/{{ .VMUser }}/bin/claude-run.sh --dangerously-skip-permissions{{ if .TelegramBotToken }} --channels plugin:telegram@claude-plugins-official{{ end }}'
      ExecStop=-/usr/bin/tmux kill-session -t claude
      Restart=always
      RestartSec=10
      EnvironmentFile=/home/{{ .VMUser }}/.claude-env

      [Install]
      WantedBy=default.target
  - path: /home/{{ .VMUser }}/.claude-env
    permissions: "0600"
    content: |
{{ if .TelegramBotToken }}      TELEGRAM_BOT_TOKEN={{ .TelegramBotToken }}
      CLAUDE_CODE_PLUGIN_SEED_DIR={{ .SeedDir }}
      TELEGRAM_STATE_DIR={{ .TelegramStateDir }}
{{ end }}      https_proxy={{ .ProxyURL }}
      HTTPS_PROXY={{ .ProxyURL }}
      DISABLE_UPDATES=1
  - path: /home/{{ .VMUser }}/.bash_aliases
    content: |
      alias claude='/usr/bin/claude --dangerously-skip-permissions'
  - path: /home/{{ .VMUser }}/CLAUDE.md
    content: |
{{ indent 6 .ClaudeMD }}
  - path: /home/{{ .VMUser }}/bin/claude-restart.sh
    permissions: "0755"
    content: |
{{ indent 6 .ClaudeRestartSh }}
  - path: /home/{{ .VMUser }}/bin/claude-run.sh
    permissions: "0755"
    content: |
{{ indent 6 .ClaudeRunSh }}
  - path: /home/{{ .VMUser }}/bin/cmd-queue.sh
    permissions: "0755"
    content: |
{{ indent 6 .CmdQueueSh }}

disk_setup:
  /dev/vdb:
    table_type: none
    overwrite: false

fs_setup:
  - device: /dev/vdb
    filesystem: ext4
    overwrite: false

mounts:
  - [/dev/vdb, "/home/{{ .VMUser }}/data", ext4, "nosuid,nodev,nofail", "0", "2"]

runcmd:
  - sysctl --system
  - systemctl disable --now systemd-resolved
  - rm -f /etc/resolv.conf
  - printf '# DNS disabled - all egress goes through proxy\n' > /etc/resolv.conf
  - chattr +i /etc/resolv.conf
  - systemctl disable cloud-init.service
  - mkdir -p /home/{{ .VMUser }}/data
  - chown {{ .VMUser }}:{{ .VMUser }} /home/{{ .VMUser }}/data
  - rm -rf /home/{{ .VMUser }}/data/.claude
  - rm -f /home/{{ .VMUser }}/data/CLAUDE.md
  - rm -f /home/{{ .VMUser }}/data/.bashrc
  - rm -f /home/{{ .VMUser }}/data/.profile
  - install -d -o {{ .VMUser }} -g {{ .VMUser }} /home/{{ .VMUser }}/data/memory
  - install -d -o {{ .VMUser }} -g {{ .VMUser }} {{ .MemoryLinkDir }}
  - test -e {{ .MemoryLink }} || test -L {{ .MemoryLink }} || ln -s /home/{{ .VMUser }}/data/memory {{ .MemoryLink }}
{{ if .TelegramBotToken }}  - install -d -m 0700 -o {{ .VMUser }} -g {{ .VMUser }} {{ .TelegramStateDir }}
{{ end }}  - chown -R {{ .VMUser }}:{{ .VMUser }} /home/{{ .VMUser }}
  - loginctl enable-linger {{ .VMUser }}
  - sleep 2
  - sudo -u {{ .VMUser }} XDG_RUNTIME_DIR=/run/user/$(id -u {{ .VMUser }}) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u {{ .VMUser }})/bus systemctl --user daemon-reload
  - sudo -u {{ .VMUser }} XDG_RUNTIME_DIR=/run/user/$(id -u {{ .VMUser }}) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u {{ .VMUser }})/bus systemctl --user enable --now claude-assistant.service
  - rm -rf /var/lib/cloud/instances /run/cloud-init
